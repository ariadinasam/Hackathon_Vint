# Copie para .env e preencha. NUNCA versione o .env.

# --- IA (OPCIONAL) ----------------------------------------------------
# Sem nenhuma chave (ou com LLM_PROVIDER=none) tudo funciona só com as regras.
# O provedor definitivo será o que a VINT GLOBAL disponibilizar; no protótipo usamos Gemini + Groq.
# Provedor principal: auto (Gemini → Groq → Claude, o que tiver chave) | gemini | groq | claude | none
# Os demais com chave viram reserva automática se o principal falhar.
LLM_PROVIDER=auto
# Chave do Gemini: https://aistudio.google.com/apikey  (a assinatura do app Gemini não é uma chave de API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Modelos reserva do Gemini quando o principal estiver sobrecarregado (503). Vazio = o app descobre sozinho.
GEMINI_MODELOS_RESERVA=

# Reserva automática: Groq (grátis, sem cartão) — https://console.groq.com/keys (chave começa com gsk_)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Qualquer serviço compatível com a API da OpenAI (ex.: um modelo interno da VINT) usa estes mesmos 3 campos:
# troque a URL abaixo, a chave e o modelo. Padrão: Groq.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Opcional, se um dia tiver a chave do Claude:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Banco SGD (somente leitura) ---------------------------------------
# Postgres do docker-compose do hackathon. Troque SEU_TOKEN pelo POSTGRES_PASSWORD do pacote.
DATABASE_URL=postgresql://hackathon:SEU_TOKEN@localhost:5432/hackathon
# Se o Postgres não responder, usa este snapshot:
SQLITE_PATH=data/sgd_snapshot.sqlite
# auto | postgres | sqlite
DATA_SOURCE=auto
# Mês de referência ("hoje") para disponibilidade, AAAA-MM. Vazio = mês atual.
REFERENCE_MONTH=

# --- Cursor (servidor MCP) ---------------------------------------------
# 0 = nomes pseudonimizados ("Colaborador 129") no chat do Cursor (recomendado, LGPD) | 1 = nomes reais
MCP_MOSTRAR_NOMES=0

# --- App (usuários, sessões, histórico) ---------------------------------
# Banco PRÓPRIO do app (não é o SGD). Criado sozinho na primeira execução.
APP_DB_PATH=data/app.db
# Domínio aceito em logins e convites. Deixe vazio para aceitar qualquer e-mail (ex.: demo).
ALLOWED_EMAIL_DOMAIN=vintglobal.com
SESSION_HOURS=12
REMEMBER_DAYS=30
# 1 quando servir em HTTPS
COOKIE_SECURE=0
